{
  "backend": {
    "repository": "mewisme/telemetry",
    "commit": "4dc7043d73dfffe621861e517b3164e4ae4b9100",
    "health_route": "/health",
    "route_template": "/v1/products/{product}/events",
    "product": "codemcp",
    "route": "/v1/products/codemcp/events",
    "schema": 1,
    "accepted_status": 202,
    "accepted_field": "accepted",
    "limits": {
      "max_body_bytes": 65536,
      "max_batch_events": 100,
      "max_string_length": 128,
      "product_pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "event_pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    }
  },
  "privacy": {
    "allowed_event_fields": [
      "name",
      "anonymous_id",
      "version",
      "os",
      "arch",
      "interface",
      "command",
      "feature",
      "error_code",
      "duration_ms",
      "success"
    ],
    "forbidden_event_fields": [
      "args",
      "arguments",
      "flags",
      "stdout",
      "stderr",
      "path",
      "workspace_id",
      "workspace_name",
      "container_id",
      "session_id",
      "session_hash",
      "prompt",
      "prompt_content",
      "skill",
      "rule",
      "project_context",
      "tool_arguments",
      "tool_result",
      "mcp_request",
      "mcp_response",
      "environment",
      "username",
      "hostname",
      "machine_id",
      "token",
      "api_key",
      "tunnel_key",
      "oauth",
      "telegram_chat_id",
      "telegram_user_id",
      "telegram_message_id",
      "approval_request_id",
      "challenge_id",
      "process_id",
      "execution_id",
      "task_id",
      "delivery_id",
      "upstream_url",
      "upstream_headers",
      "upstream_args",
      "upstream_response",
      "codegraph_content",
      "typesafe_prompt",
      "semantic_input",
      "semantic_candidate",
      "semantic_question",
      "semantic_answer",
      "semantic_risk_payload",
      "provider_response",
      "raw_error",
      "raw_event",
      "metadata"
    ],
    "error_codes": [
      "cancelled",
      "invalid_input",
      "unauthorized",
      "not_found",
      "unavailable",
      "timeout",
      "network",
      "conflict",
      "internal"
    ]
  },
  "configuration": {
    "key": "telemetry.enabled",
    "default_enabled": true,
    "env": "CM_TELEMETRY",
    "precedence": ["env", "config", "default"],
    "enable_values": ["1", "true", "yes", "on"],
    "disable_values": ["0", "false", "no", "off"],
    "invalid_env": "ignore",
    "mcp_agent_visible": false,
    "mcp_agent_writable": false
  },
  "identity": {
    "state_path": "state/product-telemetry.json",
    "schema": 1,
    "field": "anonymous_id",
    "generation": "random_uuid",
    "derived_from_machine_or_workspace": false,
    "create_when_disabled": false,
    "create_without_endpoint": false,
    "status_creates_identity": false,
    "show_creates_identity": false,
    "disable_deletes_identity": false,
    "uninit_removes_identity": true,
    "malformed_state_fails_parent_operation": false
  },
  "transport": {
    "exactly_once": false,
    "idempotency_key": false,
    "attempts_per_dequeued_batch": 1,
    "retry_ambiguous_send": false,
    "persistent_spool": false,
    "disabled_network": false,
    "endpointless_network": false,
    "status_network": false,
    "show_network": false
  }
}
